# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://maomao:maomao@postgres:5432/maomao
POSTGRES_USER=maomao
POSTGRES_PASSWORD=maomao
POSTGRES_DB=maomao

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (S3-compatible; MinIO in dev) ---
# MINIO_ENDPOINT: how the SERVER reaches MinIO (compose-internal host).
# MINIO_PUBLIC_URL: how CLIENTS (devices) reach it to download presigned audio
#   URLs — MUST be a host the phone/desktop can resolve (LAN/Tailscale IP), NOT
#   the compose hostname. Without it, server_tts / agent audio won't play.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=maomao-audio

# --- Push (Android) ---
FCM_PROJECT_ID=

# --- TTS ---
TTS_PROVIDER=edge_tts
TTS_FALLBACK_PROVIDER=client_tts
